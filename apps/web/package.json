{
  "name": "graph-engineering-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": { "node": "24.11.1", "npm": "11.6.2" },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
